# Editor defaults for this repository.
#
# The most important rule here is the charset: the driver's C sources are read by the
# MSVC toolchain with the system code page, and Chinese comments in UTF-8 without a BOM
# trigger warning C4819 (or worse, mangled output). UTF-8 with BOM is the safe choice for
# files consumed by non-Rust toolchains; Rust sources must stay UTF-8 without BOM.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.rs]
charset = utf-8
indent_size = 4
max_line_length = 100

[*.{c,h}]
# MSVC reads these with the ANSI code page unless told otherwise; a BOM makes the
# encoding unambiguous.
charset = utf-8-bom
indent_size = 4

[*.{md,yml,yaml,toml}]
indent_size = 2

[*.ps1]
charset = utf-8-bom
end_of_line = crlf
indent_size = 4

[*.{png,jpg,jpeg,ico,sys,dll,exe}]
insert_final_newline = false
trim_trailing_whitespace = false
